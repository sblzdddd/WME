{
  "name": "baka-wme",
  "private": true,
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "scripts": {
    "dev": "wrangler dev --env dev",
    "deploy": "wrangler deploy --env prod --minify",
    "cf-typegen": "wrangler types --env dev --env-interface CloudflareBindings --include-runtime false --strict-vars false",
    "typecheck": "pnpm cf-typegen --check && tsc --noEmit && tsc --noEmit -p test",
    "test": "vitest run"
  },
  "dependencies": {
    "hono": "4.13.13"
  },
  "devDependencies": {
    "@cloudflare/vitest-plugin": "1.3.7",
    "@cloudflare/workers-types": "^5.20261008.1",
    "@types/node": "^26.6.4",
    "typescript": "~6.0.3",
    "vitest": "^4.1.11",
    "wrangler": "^4.110.0"
  }
}
